# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# ARGUE IT: the AI judge (required, no default): anthropic | engine | mock (mock is for tests only)
# JUDGE_PROVIDER=anthropic
# Provider key: used by the judge (anthropic) and detected by the agent chat
# ANTHROPIC_API_KEY=
