{
  "extends": "@agent-native/core/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./app/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@domain/*": [
        "./server/domain/*"
      ],
      "server-only": [
        "./server/shims/server-only.ts"
      ],
      "next/cache": [
        "./server/shims/next-cache.ts"
      ],
      "next/navigation": [
        "./server/shims/next-navigation-server.ts"
      ],
      "next/server": [
        "./server/shims/next-server.ts"
      ],
      "@tests/helpers/*": [
        "./server/domain/test-helpers/*"
      ]
    },
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "actions/**/*",
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*",
    ".generated/**/*"
  ]
}
